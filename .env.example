# ─────────────────────────────────────────────────────────────────────────────
# Skyloon AI configuration. Copy to `.env` in the application root and fill in.
# On cPanel the .env file lives next to manage.py (outside public_html).
# ─────────────────────────────────────────────────────────────────────────────

# Never enable DEBUG on the live site.
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
APP_URL=https://www.example.com
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
TIME_ZONE=Asia/Dhaka

# ── MySQL / MariaDB (cPanel → MySQL Databases; names are prefixed with your cPanel user)
# DB_CONN_MAX_AGE=60           # keep DB connections open between requests (seconds)
DB_ENGINE=mysql
DB_NAME=cpuser_skyloon
DB_USER=cpuser_skyloon
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# ── Email (cPanel → Email Accounts → Connect Devices shows these values)
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Skyloon AI <no-reply@example.com>
# Who receives new quote / application / signup alerts (more can be added in Admin → Settings)
ADMIN_NOTIFICATION_EMAILS=hello@example.com
# EMAIL_USE_TLS=false          # true for port 587 (STARTTLS); use EMAIL_USE_SSL for 465
# EMAIL_TIMEOUT=15             # seconds before giving up on the mail server
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# true: send at the end of the request (max 10 per request, the rest by cron); false: cron only (manage.py process_emails)
EMAIL_SEND_IMMEDIATELY=true

# ── Video & file storage
# local = files on this server under PRIVATE_STORAGE_DIR (fine to start; mind your disk quota)
# s3    = S3-compatible object storage — recommended for training/feedback videos
STORAGE_BACKEND=local
# PRIVATE_STORAGE_DIR=/home/cpuser/skyloon_storage
# S3_BUCKET=skyloon-media
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com   # R2 / B2 / Wasabi endpoint (empty for AWS)
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ADDRESSING_STYLE=auto
# How long signed video/file URLs stay valid (seconds)
MEDIA_URL_TTL_SECONDS=10800
MAX_VIDEO_UPLOAD_MB=4096
MAX_DOCUMENT_UPLOAD_MB=15
# Largest single request (all files of one form together); bigger videos use chunked uploads
MAX_REQUEST_BODY_MB=30
# UPLOAD_CHUNK_SIZE=5242880     # bytes per chunk for local video uploads (keep ≤ your ModSecurity body limit)
# STATIC_ROOT=/home/cpuser/public_html/static   # where collectstatic copies CSS/JS/fonts

# ── Behaviour
EMPLOYEE_ID_PREFIX=SKY
# % of a video that must actually be played to count as watched
VIDEO_COMPLETION_THRESHOLD=90

# ── HTTPS (keep true in production; set SECURE_HSTS_SECONDS=31536000 once HTTPS works everywhere)
SECURE_HTTPS=true
SECURE_HSTS_SECONDS=0
# SECURE_SSL_REDIRECT=true      # redirect http → https in Django (cPanel can also do this)
# Behind Cloudflare or another proxy/CDN: trust its X-Forwarded-Proto and X-Forwarded-For.
# Leave both off on plain cPanel hosting — otherwise visitors could fake them.
BEHIND_HTTPS_PROXY=false
TRUSTED_PROXY_COUNT=0

# ── Logs & error alerts
# LOG_FILE=/home/cpuser/logs/skyloon.log   # rotating log file (outside public_html)
# ERROR_EMAILS=dev@example.com            # emailed when a page crashes (HTTP 500)
