# Bangla overrides for Django's built-in messages that employees see
# (password rules, password forms, email field). Compile with:
#   msgfmt -o locale/bn/LC_MESSAGES/django.mo locale/bn/LC_MESSAGES/django.po
# (or `python manage.py compilemessages`). The compiled .mo is committed so the
# server does not need gettext installed.
msgid ""
msgstr ""
"Project-Id-Version: skyloon\n"
"Language: bn\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "পাসওয়ার্ডটা খুব ছোট। কমপক্ষে %d অক্ষর দিন।"
msgstr[1] "পাসওয়ার্ডটা খুব ছোট। কমপক্ষে %d অক্ষর দিন।"

msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "পাসওয়ার্ডে কমপক্ষে %(min_length)d অক্ষর থাকতে হবে।"
msgstr[1] "পাসওয়ার্ডে কমপক্ষে %(min_length)d অক্ষর থাকতে হবে।"

msgid "The password is too similar to the %(verbose_name)s."
msgstr "পাসওয়ার্ডটা আপনার %(verbose_name)s-এর সাথে বেশি মিলে যাচ্ছে।"

msgid "Your password can’t be too similar to your other personal information."
msgstr "পাসওয়ার্ড যেন আপনার নাম বা ইমেইলের সাথে বেশি না মেলে।"

msgid "This password is too common."
msgstr "এই পাসওয়ার্ডটা খুব বেশি প্রচলিত — অন্য কিছু দিন।"

msgid "Your password can’t be a commonly used password."
msgstr "খুব প্রচলিত পাসওয়ার্ড (যেমন 12345678) ব্যবহার করা যাবে না।"

msgid "This password is entirely numeric."
msgstr "পাসওয়ার্ডে শুধু সংখ্যা রাখা যাবে না।"

msgid "Your password can’t be entirely numeric."
msgstr "পাসওয়ার্ড শুধু সংখ্যা দিয়ে বানানো যাবে না — অক্ষরও রাখুন।"

msgid "The two password fields didn’t match."
msgstr "দুইবার লেখা পাসওয়ার্ড মিলছে না।"

msgid "Your old password was entered incorrectly. Please enter it again."
msgstr "পুরোনো পাসওয়ার্ডটা ঠিক হয়নি। আবার লিখুন।"

msgid "Email"
msgstr "ইমেইল"

msgid "Enter a valid email address."
msgstr "সঠিক ইমেইল ঠিকানা লিখুন।"

msgid "email"
msgstr "ইমেইল"

msgid "name"
msgstr "নাম"

msgid "This field is required."
msgstr "এই ঘরটি পূরণ করতে হবে।"

#, python-format
msgid "Ensure this value has at most %(limit_value)d character (it has %(show_value)d)."
msgid_plural "Ensure this value has at most %(limit_value)d characters (it has %(show_value)d)."
msgstr[0] "সর্বোচ্চ %(limit_value)d অক্ষর লেখা যাবে (এখন আছে %(show_value)d)।"
msgstr[1] "সর্বোচ্চ %(limit_value)d অক্ষর লেখা যাবে (এখন আছে %(show_value)d)।"

#, python-format
msgid "Ensure this value has at least %(limit_value)d character (it has %(show_value)d)."
msgid_plural "Ensure this value has at least %(limit_value)d characters (it has %(show_value)d)."
msgstr[0] "কমপক্ষে %(limit_value)d অক্ষর লিখতে হবে (এখন আছে %(show_value)d)।"
msgstr[1] "কমপক্ষে %(limit_value)d অক্ষর লিখতে হবে (এখন আছে %(show_value)d)।"

msgid "Enter a valid date."
msgstr "সঠিক তারিখ লিখুন।"

msgid "Enter a whole number."
msgstr "একটি পূর্ণ সংখ্যা লিখুন।"

msgid "Enter a valid URL."
msgstr "সঠিক লিংক (URL) লিখুন।"

#, python-format
msgid "Select a valid choice. %(value)s is not one of the available choices."
msgstr "সঠিক একটি অপশন বেছে নিন। %(value)s তালিকায় নেই।"

msgid "The submitted file is empty."
msgstr "জমা দেওয়া ফাইলটি খালি।"
